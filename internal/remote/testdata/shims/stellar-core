#!/bin/sh
# Test shim for stellar-core. Logs its argv to $SHIM_LOG. Like stellar-core
# 30, gen-seed and sec-to-pub reject --conf.
printf '%s\n' "stellar-core $* [cwd=$PWD]" >>"${SHIM_LOG:-/dev/null}"
conf=0
while [ $# -gt 0 ]; do
	case "$1" in
	--conf) conf=1; shift 2 ;;
	*) break ;;
	esac
done
case "$1" in
gen-seed | sec-to-pub)
	if [ $conf = 1 ]; then
		echo "Unrecognised token: --conf" >&2
		exit 1
	fi
	;;
esac
case "$1" in
version)
	echo "stellar-core 30.0.0 (shim)"
	echo "ledger protocol version: 30"
	;;
gen-seed)
	if [ -n "$SHIM_GEN_FAIL" ]; then echo "gen-seed failed" >&2; exit 1; fi
	echo "Secret seed: SAAACAQDAQCQMBYIBEFAWDANBYHRAEISCMKBKFQXDAMRUGY4DUPB6NKI"
	echo "Public: GAB2CB576PHBBPQ5ODORRZ2LYCMWPZGWGCN2KDK7DXOIMZASKUY3QZ6Q"
	;;
new-db | new-hist)
	if [ -n "$SHIM_INIT_FAIL" ]; then echo "$1 failed" >&2; exit 1; fi
	;;
sec-to-pub)
	IFS= read -r seed
	case "$seed" in
	SDHOAMBNLGCE2MV5ZKIVZAQD3VCLGP53P3OBSBI6UN5L5XZI5TKHFQL4) echo GBRPYHIL2CI3FNQ4BXLFMNDLFJUNPU2HY3ZMFSHONUCEOASW7QC7OX2H ;;
	SAAACAQDAQCQMBYIBEFAWDANBYHRAEISCMKBKFQXDAMRUGY4DUPB6NKI) echo GAB2CB576PHBBPQ5ODORRZ2LYCMWPZGWGCN2KDK7DXOIMZASKUY3QZ6Q ;;
	*) echo "invalid seed" >&2; exit 1 ;;
	esac
	;;
http-command)
	printf '{"shim":"http-command","cmd":"%s"}\n' "$2"
	;;
*)
	echo "stellar-core shim: unsupported command $1" >&2
	exit 1
	;;
esac
